# .gitignore for Siemens TIA Portal projects
#
# The files that must stay in the repository are the project file (*.ap*),
# the System folder (PEData.plf and PEData.idx), AdditionalFiles and UserFiles.
# Everything below is regenerated by TIA Portal or is specific to one machine.

# Internal media and index folders (search index, HMI and SPL caches)
IM/
**/IM/

# Temporary working directory created while a project is open
TMP/
**/TMP/

# Project upgrade, conversion and compile logs
Logs/
**/Logs/

# Cross-reference database, rebuilt on compile
XRef/
**/XRef/

# Version control interface database, recreated on project open
Vci/
**/Vci/

# Lock and session files created while the project is open
*.lock
*.ap*.lock
*.tmp
*.temp
~$*
*~
.~lock.*

# Local project backups and archive copies
*.bak
*.backup
*.old
*.orig
*.zap*
*.za*
Backup/
Backups/
**/Backup/
**/Backups/

# Compile and download outputs
*.log
*.err
*.cache
CompileOutput/
**/CompileOutput/

# HMI runtime and compile artifacts
HMI_RT*/
**/HMI_RT*/
*.hmi.tmp

# Generated documents and exports not meant for source control
*.pdf.tmp
Export/
**/Export/

# User-specific settings and engineering workspace state
*.user
*.suo
*.workspace
.vs/
.idea/
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
